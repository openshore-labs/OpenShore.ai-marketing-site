{#- The shared frame for OpenShore, the site's home (/), and
    the platform page (/enterprise/platform/): its
    own small header, a strict same-origin policy, the light stylesheet, and
    the footer. No download or checkout runtime. The header leads with
    OpenShore; OS Code by OpenShore stays out of it, and since 2026-11-18
    (founder) out of the footer too. The company About page
    is /about/ (at /grow-with-us/ from 2026-11-16 to 2026-11-23). The privacy
    policy and terms under /os-code/ are OS Code by OpenShore's; OpenShore
    has its own at /privacy/, /terms/ and /support/
    (2026-11-16), which this footer links to. Under the header sit the tabs
    (src/_data/entTabs.js): Overview, Product Tour, Pricing, Security and About. -#}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    {% if pageNoindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}{{ pageOgImage or (('/enterprise/og-enterprise.jpg?v=') + rev.entOg) }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-standard.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/enterprise/enterprise.css?v={{ rev.entCss }}" />
  </head>
  <body>
    <header class="ent-top">
      <a class="ent-brand" href="/" aria-label="OpenShore, home">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
          <rect width="32" height="32" rx="7.5" fill="#1c2a33" />
          <g transform="translate(0 -0.81)">
            <line x1="7" y1="13" x2="25" y2="13" stroke="#f6f4ef" stroke-width="2" stroke-linecap="round" />
            <path d="M7 19q4.5-3.3 9 0t9 0" fill="none" stroke="#4b90a3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        </svg>
        <span><b>OpenShore</b></span>
      </a>
      <a class="ent-badge ent-badge--top" href="/pricing/#design-partners"><span class="ent-dot" aria-hidden="true"></span><span class="ent-pill-t"><span>Piloting now.</span> <span>Design with us.</span></span></a>
    </header>
    <nav class="ent-tabs" aria-label="OpenShore"><div class="ent-tabs-row">
{%- for t in entTabs %}
      <a href="{{ t.href }}"{% if page.url == t.href %} aria-current="page"{% endif %}>{{ t.label }}{% if t.locked %}<svg class="ent-tab-lock" viewBox="0 0 12 14" width="11" height="13" aria-label="sign-in needed" role="img"><rect x="1" y="6" width="10" height="7.5" rx="2" fill="currentColor"/><path d="M3.5 6V4.2a2.5 2.5 0 0 1 5 0V6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>{% endif %}</a>
{%- endfor %}
    </div></nav>

    <main>
{{ content | safe }}
    </main>

    {#- The floating design partner button (founder, 2026-11-20), on every
        page: it lands on the offer at the foot of Pricing and steps aside
        while the offer, or the home page's hero button (back since
        2026-11-24, the same words and link), is on screen
        (/enterprise/float.js). -#}
    <a class="ent-btn ent-btn--primary ent-float" href="{{ pilot.buttonHref }}" data-float>{{ pilot.button }}</a>

    <footer class="ent-foot">
      <nav class="ent-foot-site" aria-label="OpenShore pages">{% for t in entTabs %}{% if not loop.first %} · {% endif %}<a href="{{ t.href }}"{% if page.url == t.href %} aria-current="page"{% endif %}>{{ t.label }}</a>{% endfor %}</nav>
      <span>OpenShore is a product of <a href="{{ site.parentUrl }}">{{ site.parentName }}</a>.</span>
      <nav aria-label="Policies">{% for l in [["Privacy", "/privacy/"], ["Terms", "/terms/"], ["Support", "/support/"]] %}{% if not loop.first %} · {% endif %}<a href="{{ l[1] }}"{% if page.url == l[1] %} aria-current="page"{% endif %}>{{ l[0] }}</a>{% endfor %}</nav>
    </footer>
    <script src="/enterprise/nav.js?v={{ rev.entNav }}" defer></script>
    <script src="/enterprise/illus.js?v={{ rev.entIllus }}" defer></script>
    <script src="/enterprise/float.js?v={{ rev.entFloat }}" defer></script>
  </body>
</html>
