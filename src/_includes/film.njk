{# The launch film, first on the home page. It plays muted on arrival
   (browsers only allow sound after a tap); one tap turns the music on. It
   holds on its last frame and offers a replay. site.js wires the buttons and
   honors reduced motion. #}
<section class="film" aria-label="OpenShore launch film">
  <div class="film-frame">
    <video
      class="film-video"
      poster="/film/openshore-film-poster.jpg?v={{ rev.filmPoster }}"
      muted
      playsinline
      preload="auto"
      data-film
      data-title-poster="/film/openshore-film-title.jpg?v={{ rev.filmTitle }}"
    >
      <source src="/film/openshore-film.mp4?v={{ rev.film }}" type="video/mp4" />
      <source src="/film/openshore-film.webm?v={{ rev.filmWebm }}" type="video/webm" />
    </video>
    <div class="film-controls">
      <button class="film-btn" type="button" data-film-sound aria-label="Turn sound on" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" data-icon="muted"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" /><path d="M16 9.5l5 5M21 9.5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" data-icon="sound" hidden><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" /><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        <span class="film-btn-label" data-film-sound-label>Sound on</span>
      </button>
      <button class="film-btn" type="button" data-film-toggle aria-label="Pause film">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" data-icon="pause"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none" /></svg>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" data-icon="play" hidden><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" data-icon="replay" hidden><path d="M5 12a7 7 0 1 0 2.05-4.95M5 4v4h4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
        <span class="film-btn-label" data-film-label>Pause</span>
      </button>
    </div>
  </div>
  <p class="film-credit">Music: &ldquo;Gods Notebook (Main Theme)&rdquo;, CC0, public domain.</p>
</section>
