<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle or site.metaDescription }}</title>
    <meta name="description" content="{{ pageDescription or site.metaDescription }}" />
    {% if pageNoindex %}<meta name="robots" content="noindex, follow" />{% endif %}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b1417" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Fetchable-directive CSP as defense-in-depth. Everything is same-origin
         (fonts self-hosted), so the policy is a strict 'self' plus the one
         Supabase origin the checkout/sign-in runtime talks to, sourced from
         the single URL in _data/oscode.js so it cannot drift. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self' {{ oscode.checkout.supabaseUrl }}; base-uri 'none'; form-action 'none'"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ pageTitle or site.metaDescription }}" />
    <meta property="og:description" content="{{ pageDescription or site.metaDescription }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ pageOgImage or (site.url + '/og-openshore.png?v=' + rev.ogImage) }}" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="OpenShore. Your machine. Your models. Your keys. A coding agent that runs on your own models, your machine, and your keys." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/fraunces-standard.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/styles.css?v={{ rev.css }}" />
    <link rel="stylesheet" href="/openshore.css?v={{ rev.productCss }}" />

    <!-- Organization record, legible to KYC crawlers/agents: OpenShore is a
         product of Open Shore, LLC. Page-specific SoftwareApplication schema
         is emitted in-body (valid JSON-LD). -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "{{ site.legalName }}",
        "url": "{{ site.parentUrl }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}"
        }
      }
    </script>
  </head>
  <body>
    <nav class="sitenav sitenav--oscode" aria-label="Primary">
      <div class="sitenav-top">
      <div class="brand brand--oscode">
        <a class="brand-home" href="/" aria-label="OpenShore home">
          <svg class="brand-mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="7.5" fill="#1c2a33" />
            <!-- Mark nudged up 0.81 so it sits optically centered in the tile. -->
            <g transform="translate(0 -0.81)">
              <line x1="7" y1="13" x2="25" y2="13" stroke="#f6f4ef" stroke-width="2" stroke-linecap="round" />
              <path d="M7 19q4.5-3.3 9 0t9 0" fill="none" stroke="#4b90a3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          </svg>
          <span class="brand-word">OpenShore</span>
        </a>
        <a class="brand-sub" href="{{ site.parentUrl }}">Brought to you by {{ site.parentName }}</a>
      </div>
        <!-- The open source invitation: the GitHub mark and a short label,
             top right on every page. No live star count, so a visit makes no
             call to GitHub and the CSP stays 'self'. -->
        <a class="source-link" href="{{ site.sourceUrl }}" rel="noopener" aria-label="OpenShore is open source. View the code on GitHub">
          <svg class="source-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          <span class="source-label"><span class="source-label-long">Open source on </span>GitHub</span>
        </a>
      </div>
      <ul class="sitenav-tabs" role="list" aria-label="Sections">
        {% for t in nav.tabs %}
        <li>
          <a
            class="sitenav-tab{% if page.url == t.url %} is-active{% endif %}"
            href="{{ t.url }}"
            {% if page.url == t.url %}aria-current="page"{% endif %}
          >{{ t.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
    <main class="page page--oscode">
      {{ content | safe }}
    </main>
  </body>
</html>
