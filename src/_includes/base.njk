{#- The frame for the OS Code by OpenShore pages (/os-code/ and its tabs,
    the privacy policy, terms and support under /about/). OpenShore for
    Enterprise, the site's home, has its own frame (ent-layout.njk). -#}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle or site.metaDescription }}</title>
    <meta name="description" content="{{ pageDescription or site.metaDescription }}" />
    {% if pageNoindex %}<meta name="robots" content="noindex, follow" />{% endif %}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b1417" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Fetchable-directive CSP as defense-in-depth. Everything is same-origin
         (fonts self-hosted), so the policy is a strict 'self' plus the one
         Supabase origin the checkout/sign-in runtime talks to, sourced from
         the single URL in _data/oscode.js so it cannot drift. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self' {{ oscode.checkout.supabaseUrl }}; base-uri 'none'; form-action 'none'"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ pageTitle or site.metaDescription }}" />
    <meta property="og:description" content="{{ pageDescription or site.metaDescription }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ pageOgImage or (site.url + '/og-openshore.png?v=' + rev.ogImage) }}" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="OS Code by OpenShore. Your personal coding agent. Free and private by default." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/fraunces-standard.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/styles.css?v={{ rev.css }}" />
    <link rel="stylesheet" href="/openshore.css?v={{ rev.productCss }}" />

    <!-- Organization record, legible to KYC crawlers/agents: OpenShore is a
         product of Open Shore, LLC. Page-specific SoftwareApplication schema
         is emitted in-body (valid JSON-LD). -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "{{ site.legalName }}",
        "url": "{{ site.parentUrl }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}"
        }
      }
    </script>
  </head>
  <body>
    <nav class="sitenav sitenav--oscode" aria-label="Primary">
      <div class="sitenav-top">
      <div class="brand brand--oscode">
        <a class="brand-home" href="{{ site.personalUrl }}" aria-label="{{ site.personalName }}">
          <svg class="brand-mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="7.5" fill="#1c2a33" />
            <!-- Mark nudged up 0.81 so it sits optically centered in the tile. -->
            <g transform="translate(0 -0.81)">
              <line x1="7" y1="13" x2="25" y2="13" stroke="#f6f4ef" stroke-width="2" stroke-linecap="round" />
              <path d="M7 19q4.5-3.3 9 0t9 0" fill="none" stroke="#4b90a3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          </svg>
          <span class="brand-word">{{ site.personalName }}</span>
        </a>
        <a class="brand-sub" href="/"><span aria-hidden="true">&larr;</span> OpenShore for Enterprise</a>
      </div>
      {# The web app lives at /os-code/app/ (2026-11-16; at / from 2026-11-07),
         and this is the way to it, on every width. #}
      <a class="app-link" href="/os-code/app/">Open the web app <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="sitenav-row">
      <ul class="sitenav-tabs" role="list" aria-label="Sections">
        {% for t in nav.tabs %}
        <li>
          <a
            class="sitenav-tab{% if page.url == t.url %} is-active{% endif %}"
            href="{{ t.url }}"
            {% if page.url == t.url %}aria-current="page"{% endif %}
          >{{ t.label }}</a>
        </li>
        {% endfor %}
      </ul>
      {# Stays in reach while the header is pinned (desktop only). #}
      <a class="nav-cta" href="/os-code/#get-app" data-download-cta>Download</a>
      </div>
    </nav>
    <main class="page page--oscode">
      {{ content | safe }}
    </main>
    {% include "sitefoot.njk" %}
    <!-- A quiet way to reach us from any page: the envelope alone. -->
    <a class="consult-fab consult-fab--glyph" href="mailto:{{ site.emails.oscode }}?subject={{ 'OpenShore' | urlencode }}" aria-label="Email OpenShore at {{ site.emails.oscode }}" title="Email us">
      <svg class="consult-fab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
    </a>
    <script src="/site.js?v={{ rev.siteJs }}" defer></script>
  </body>
</html>
