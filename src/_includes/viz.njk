{# ============================================================================
   Render helpers + guiding visuals for the tab pages.
   - sec(s): one content section (heading -> eyebrow, body -> lede, bullets ->
     why-list, steps -> components), matching the Platform page's vocabulary.
   - Diagrams are inline SVG on the Nightshore dark palette (teal #5bb6cb =
     local/private, amber #e0902f = cloud/spend), scalable via viewBox.
   - Phone mockups are HTML in the app's real warm CREAM theme (its accent
     grammar is load-bearing), framed by .phone so they lift off the dark page.
   No em dashes anywhere (enforced by scripts/check-copy.mjs).
============================================================================ #}

{% macro sec(s) %}
<section class="block">
  <h2 class="eyebrow">{{ s.heading }}</h2>
  <p class="lede">{{ s.body }}</p>
  {% if s.bullets %}
  <ul class="why-list">
    {% for b in s.bullets %}
    <li><strong>{{ b.label }}.</strong> {{ b.text }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if s.steps %}
  <ol class="components">
    {% for step in s.steps %}
    <li class="component">
      <span class="component-name">{{ step.name }}</span>
      <span class="component-body">{{ step.body }}</span>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</section>
{% endmacro %}

