{% macro _seat(x, cat, model, src, effort) %}
{% set dot = "#5bb6cb" if src != "cloud" else "#e0902f" %}
<g>
  <rect x="{{ x }}" y="214" width="116" height="150" rx="14"
        fill="#152a33" stroke="{{ '#5bb6cb' if src == 'byom' else '#24424d' }}"
        stroke-width="{{ 1.4 if src == 'byom' else 1 }}" {{ 'stroke-dasharray="5 4"' | safe if src == 'byom' }}/>
  <text x="{{ x + 16 }}" y="242" font-family="Inter, sans-serif" font-weight="700" font-size="14.5" fill="#f6f4ef">{{ cat }}</text>
  <circle cx="{{ x + 100 }}" cy="237" r="5" fill="{{ dot }}"/>
  <text x="{{ x + 16 }}" y="286" font-family="Inter, sans-serif" font-size="12.5" fill="#a9bac0">{{ model }}</text>
  {% if src == "byom" %}
  <text x="{{ x + 16 }}" y="304" font-family="Inter, sans-serif" font-size="10.5" fill="#8fd3e2">you host</text>
  {% elif src == "cloud" %}
  <text x="{{ x + 16 }}" y="304" font-family="Inter, sans-serif" font-size="10.5" fill="#e0a25a">on your key</text>
  {% else %}
  <text x="{{ x + 16 }}" y="304" font-family="Inter, sans-serif" font-size="10.5" fill="#7fb8a0">on device</text>
  {% endif %}
  <rect x="{{ x + 16 }}" y="330" width="52" height="18" rx="9" fill="#0e2530" stroke="#24424d"/>
  <text x="{{ x + 42 }}" y="343" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#a9bac0">{{ effort }}</text>
</g>
{% endmacro %}

