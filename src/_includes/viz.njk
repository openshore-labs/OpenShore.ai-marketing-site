      </g>
      <text x="509" y="99" text-anchor="middle" font-family="Inter, sans-serif" font-size="9.5" fill="#c99a63">per token</text>
      <g transform="translate(556 84)">
        <rect x="0" y="0" width="96" height="88" rx="10" fill="#231a10" stroke="#e0902f" stroke-width="1.1"/>
        <g stroke="#e0902f" stroke-width="1.4" fill="none">
