      </g>
      <path d="M198 108 a44 30 0 1 1 -0.1 0" fill="none" stroke="#5bb6cb" stroke-width="2" marker-end="url(#lc-a-teal)"/>
      <text x="196" y="200" text-anchor="middle" font-family="Inter, sans-serif" font-weight="600" font-size="13" fill="#f6f4ef">answer stays here</text>
      <text x="196" y="220" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#7fb8a0">short trip, power you already pay for</text>
