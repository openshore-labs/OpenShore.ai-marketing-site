{# ---- Ethics: three-signal quick-scan (mirrors the app's ethics grammar) - #}
{% macro ethicsSignals() %}
<div class="signals">
  <div class="signal signal--refuse">
    <div class="signal-head"><span class="signal-dot"></span><span class="signal-name">Refused outright</span></div>
    <p class="signal-body">Child sexual abuse material, sexual imagery of a real person, and weapons uplift. There is no consent option.</p>
  </div>
  <div class="signal signal--gate">
    <div class="signal-head"><span class="signal-dot"></span><span class="signal-name">Gated behind consent</span></div>
    <p class="signal-body">Cloning a real face or voice, allowed only when you state you are authorized. What comes out is marked AI-generated.</p>
  </div>
  <div class="signal signal--allow">
    <div class="signal-head"><span class="signal-dot"></span><span class="signal-name">Left alone</span></div>
    <p class="signal-body">Legal adult content, dark fiction, satire, security research, and unpopular opinions. No added refusal.</p>
  </div>
</div>
{% endmacro %}
