        <marker id="lc-a-teal" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0 0 L7 3 L0 6 Z" fill="#5bb6cb"/></marker>
        <marker id="lc-a-amber" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0 0 L7 3 L0 6 Z" fill="#e0902f"/></marker>
      </defs>
      <!-- divider -->
      <line x1="340" y1="24" x2="340" y2="252" stroke="#24424d" stroke-width="1" stroke-dasharray="3 5"/>
      <!-- LEFT: on your machine -->
      <text x="30" y="40" font-family="Inter, sans-serif" font-weight="700" font-size="13" fill="#8fd3e2" letter-spacing="0.4">ON YOUR MACHINE</text>
      <g transform="translate(70 78)">
