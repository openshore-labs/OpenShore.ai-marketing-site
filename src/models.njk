---
layout: base.njk
permalink: /models/
pageTitle: "Models · OpenShore"
pageDescription: "OpenShore starts with three models: Harbor Lite, a guide on your phone; Harbor, a small coder on your iPhone; and DeepBlue, a coding agent sized to your computer. Add a model you host, or cloud on your own key."
---
{# Was "LLM Choice" at /llm-choice/, which now 301s here (static/_redirects). #}
{% import "viz.njk" as viz %}
{% set p = tabpages["models"] %}

<header class="subhero">
  <span class="eyebrow">{{ p.hero.eyebrow }}</span>
  <h1>{{ p.hero.headline }}</h1>
  <p class="subhead">{{ p.hero.subhead }}</p>
</header>

<div class="block split">
  <div class="split-text">
    <h2 class="eyebrow">{{ p.sections[0].heading }}</h2>
    <p class="lede">{{ p.sections[0].body }}</p>
    <ul class="why-list">
      {% for b in p.sections[0].bullets %}<li><strong>{{ b.label }}.</strong> {{ b.text }}</li>{% endfor %}
    </ul>
    {% if p.sections[0].note %}<p class="offer-fine">{{ p.sections[0].note }}</p>{% endif %}
  </div>
  <div class="split-media">{{ viz.deepBlueCard() }}</div>
</div>

{{ viz.sec(p.sections[1]) }}
{{ viz.sec(p.sections[2]) }}

<section class="block">{{ viz.stackRouting() }}</section>

<section class="block">
  <a class="block-cta" href="{{ p.cta.href }}">{{ p.cta.label }} <span aria-hidden="true">&rarr;</span></a>
  {% if p.cta.note %}<p class="offer-fine">{{ p.cta.note }}</p>{% endif %}
</section>
