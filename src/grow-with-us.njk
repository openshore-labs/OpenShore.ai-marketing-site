---
layout: ent-layout.njk
permalink: /grow-with-us/
pageTitle: "About · OpenShore"
pageDescription: "Why OpenShore exists: our mission, the principles we build by, and the founder behind it."
---
{#- Grow with Us (founder, 2026-11-16): the mission, the principles from the
    business plan's appendix, then the founder. The words live in
    src/_data/growWithUs.js; an empty section is left off the page. -#}
{%- set g = growWithUs -%}
      <section class="ent-sec ent-sec--first" aria-labelledby="mission-h">
        <h1 class="ent-eyebrow" id="mission-h">Our mission</h1>
        <p class="ent-statement">{{ g.mission }}</p>
        <p class="ent-body">{{ g.missionLine }}</p>
      </section>

{% if g.principles.length %}
      <section class="ent-sec" aria-labelledby="principles-h">
        <h2 class="ent-eyebrow" id="principles-h">{{ g.principlesTitle }}</h2>
        <p class="ent-body ent-principles-lede">{{ g.principlesLede }}</p>
{% include "ill-flywheel.njk" %}
        <ol class="ent-principles">
{%- for p in g.principles %}
          <li>
            <h3>{{ p.title }}</h3>
            <p>{{ p.body }}</p>
          </li>
{%- endfor %}
        </ol>
      </section>
{% endif %}
{%- if g.founder.paragraphs.length %}
      <section class="ent-sec" aria-labelledby="founder-h">
        <h2 class="ent-eyebrow" id="founder-h">The founder</h2>
        <div class="ent-founder">
          {% if g.founder.photo %}<img class="ent-founder-photo" src="/enterprise/founder.jpg?v={{ rev.entFounder }}" alt="{{ g.founder.alt }}" width="640" height="640" />{% endif %}
          <div class="ent-founder-text">
            <h3 class="ent-h">{{ g.founder.name }}</h3>
            <p class="ent-founder-role">{{ g.founder.role }}</p>
{%- for para in g.founder.paragraphs %}
            <p class="ent-body">{{ para }}</p>
{%- endfor %}
            {% if g.founder.linkedin %}<p class="ent-founder-links"><a href="{{ g.founder.linkedin }}" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">&#8599;</span></a></p>{% endif %}
          </div>
        </div>
      </section>
{% endif %}
