{# The "Get OpenShore" tile grid: same shape and same honesty rule as
   uki.audio's own get-app section (see that repo's index.njk). A tile is
   interactive only once its href is real; otherwise it renders disabled with
   a "Coming soon" chip rather than a link that would 404. #}
<section class="block" aria-labelledby="get-app-heading" id="get-app">
  <h2 id="get-app-heading" class="eyebrow">{{ oscode.getAppsLabel }}</h2>
  <p class="lede">{{ oscode.getAppsTitle }}</p>
  <p class="prose">{{ oscode.getAppsLede }}</p>
  <ul class="get-app">
    {% for app in oscode.getApps %}
    {% set live = app.status == 'live' and app.href %}
    <li>
      {% if live and app.download %}
      <a class="get-tile get-tile-live" href="{{ app.href }}" download>
      {% elif live %}
      <a class="get-tile get-tile-live" href="{{ app.href }}" target="_blank" rel="noopener noreferrer">
      {% else %}
      <div class="get-tile is-soon" aria-disabled="true">
      {% endif %}
        <span class="get-glyph" aria-hidden="true">{{ getGlyph(app.id) | safe }}</span>
        <span class="get-label">{{ app.label }}</span>
        <span class="get-sub">{{ app.sub }}</span>
        <span class="get-chip{% if live %} get-chip-live{% endif %}">{% if live %}Get{% else %}Coming soon{% endif %}</span>
      {% if live %}</a>{% else %}</div>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>

{# The mission, in the founder's words. The four promises render as the quiet
   label-plus-line list (the pricing trust row's shape), not cards. #}
<section class="block" aria-labelledby="mission-heading">
  <h2 id="mission-heading" class="eyebrow">{{ oscode.missionLabel }}</h2>
  <p class="lede">{{ oscode.mission }}</p>
  <ul class="why-list">
    {% for w in oscode.why %}
    <li><strong>{{ w.label }}</strong> {{ w.body }}</li>
    {% endfor %}
  </ul>
</section>

<section class="block" aria-labelledby="pillars-heading">
  <h2 id="pillars-heading" class="eyebrow">{{ oscode.pillarsLabel }}</h2>
  <ul class="pillars">
    {% for p in oscode.pillars %}
    <li class="pillar">
      <p class="pillar-name">{{ p.name }}</p>
      <p class="pillar-promise">{{ p.promise }}</p>
      <p class="pillar-covers">{{ p.covers }}</p>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="block" aria-labelledby="how-heading">
  <h2 id="how-heading" class="eyebrow">{{ oscode.howLabel }}</h2>
  <ol class="components">
    {% for step in oscode.how %}
    <li class="component">
      <span class="component-name">{{ step.name }}</span>
      <span class="component-body">{{ step.body }}</span>
    </li>
    {% endfor %}
  </ol>
</section>

{# Everything inside: the full feature set, one line each, in the same quiet
   list shape as the mission so it scans rather than shouts. #}
<section class="block" aria-labelledby="pieces-heading" id="everything">
  <h2 id="pieces-heading" class="eyebrow">{{ oscode.piecesLabel }}</h2>
  <p class="lede">{{ oscode.piecesIntro }}</p>
  <ul class="why-list">
    {% for piece in oscode.pieces %}
    <li><strong>{{ piece.label }}</strong> {{ piece.body }}</li>
    {% endfor %}
  </ul>
</section>

<section class="block" aria-labelledby="pricing-heading" id="pricing">
  <h2 id="pricing-heading" class="eyebrow">{{ oscode.pricingLabel }}</h2>
  <p class="lede">{{ oscode.pricingIntro }}</p>
  {% if oscode.betaNote %}<p class="offer-fine">{{ oscode.betaNote }}</p>{% endif %}
  <div class="offers">
    {% for plan in oscode.plans %}
    <article class="offer{% if plan.flagship %} offer--flagship{% endif %}" id="plan-{{ plan.id }}">
      <div class="offer-summary">
        <span class="offer-head">
          <span class="offer-segment">{{ plan.segment }}</span>
          <span class="offer-name">{{ plan.name }}{% if plan.flagship %} <span class="offer-flag">{{ plan.flagLabel or 'Most popular' }}</span>{% endif %}</span>
        </span>
        <span class="offer-price">{{ plan.price }}</span>
      </div>
      <div class="offer-detail">
        <div class="offer-detail-inner">
          <p class="offer-promise">{{ plan.promise }}</p>
          <div class="offer-slot offer-deliver">
            <p class="offer-slot-label">What's included</p>
            <ul class="track-includes">
              {% for item in plan.includes %}<li>{{ item }}</li>{% endfor %}
            </ul>
          </div>
          {% if plan.id == 'free' or plan.id == 'personal' %}
          <a class="block-cta" href="mailto:{{ site.emails.oscode }}?subject={{ (plan.name + ' · OpenShore') | urlencode }}">{{ plan.cta }} <span aria-hidden="true">&rarr;</span></a>
          {% elif plan.buyable or plan.segment == 'For teams' %}
          <button type="button" class="block-cta" data-tier="{{ plan.id }}">{{ plan.cta }} <span aria-hidden="true">&rarr;</span></button>
          {% endif %}
          {% if plan.finePrint %}<p class="offer-fine">{{ plan.finePrint }}</p>{% endif %}
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
  {% if oscode.teamNote %}<p class="offer-fine">{{ oscode.teamNote }}</p>{% endif %}
  <ul class="offer-reassure">
    {% for r in oscode.reassurance %}
    <li><strong>{{ r.label }}</strong> {{ r.body }}</li>
    {% endfor %}
  </ul>
</section>

{# The ethical boundaries. Mirrors the trust statement shown in the app's
   Settings, from one source of copy in _data/oscode.js. #}
<section class="block" aria-labelledby="trust-heading" id="ethics">
  <h2 id="trust-heading" class="eyebrow">{{ oscode.trust.label }}</h2>
  <p class="lede">{{ oscode.trust.stanceLabel }}</p>
  <div class="stance">
    {% for line in oscode.trust.stance %}
    <p class="prose">{{ line }}</p>
    {% endfor %}
  </div>
  <p class="prose"><strong>{{ oscode.trust.headline }}</strong></p>
  <ul class="pillars">
    {% for t in oscode.trust.tiers %}
    <li class="pillar">
      <p class="pillar-name">{{ t.name }}</p>
      <p class="pillar-covers">{{ t.body }}</p>
    </li>
    {% endfor %}
  </ul>
  <p class="prose">{{ oscode.trust.honestLimit }}</p>
  <p class="prose">{{ oscode.trust.privacy }}</p>
  <p class="offer-fine">
    <a href="/ethics/">Read the full statement</a> or the
    <a href="/terms/">Terms of Use</a>.
  </p>
</section>

<section class="block" aria-labelledby="close-heading" id="early-access">
  <h2 id="close-heading" class="eyebrow">Early access</h2>
  <p class="lede lede--close">{{ oscode.close }}</p>
  <div class="contact">
    <p class="contact-line">
      <span class="contact-label">Email</span>
      <a href="mailto:{{ site.emails.oscode }}?subject={{ oscode.earlyAccessSubject | urlencode }}&amp;body={{ oscode.earlyAccessBody | urlencode }}">{{ site.emails.oscode }}</a>
    </p>
  </div>
</section>

<footer class="colophon">
  <p><a href="{{ site.parentUrl }}">&larr; {{ site.parentName }}</a></p>
  <p>&copy; {{ site.year }} {{ site.legalName }}. OpenShore is a product of {{ site.legalName }}.</p>
</footer>

<a
  class="consult-fab"
  href="mailto:{{ site.emails.oscode }}?subject={{ oscode.earlyAccessSubject | urlencode }}&amp;body={{ oscode.earlyAccessBody | urlencode }}"
  aria-label="Email for OpenShore early access"
>
  <svg class="consult-fab-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="m3 7 9 6 9-6" />
  </svg>
  <span class="consult-fab-label">{{ oscode.fabLabel }}</span>
</a>

<dialog id="oscode-login" class="oscode-login" aria-labelledby="oscode-login-title">
  <button type="button" class="oscode-login-close" aria-label="Close">&times;</button>
  <h2 id="oscode-login-title" class="oscode-login-title">Log in</h2>
  <p class="oscode-login-sub">Sign in with the same account you use in the OpenShore app. Personal use needs no account.</p>
  <form>
    <label class="oscode-field">
      <span>Email</span>
      <input id="oscode-email" type="email" autocomplete="email" autocapitalize="none" placeholder="you@company.com" />
    </label>
    <label class="oscode-field">
      <span>Password</span>
      <input id="oscode-password" type="password" autocomplete="current-password" placeholder="Password" />
    </label>
    <p class="oscode-login-error" role="alert"></p>
    <button type="submit" class="block-cta oscode-login-submit">Log in</button>
    <button type="button" class="oscode-login-toggle">New here? Create an account</button>
  </form>
</dialog>

<script src="/openshore-app.js?v={{ rev.appJs }}" defer></script>
