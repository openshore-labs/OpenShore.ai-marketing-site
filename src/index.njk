---
layout: base.njk
permalink: /
pageTitle: "OpenShore: Your machine, your models, your keys"
pageDescription: "OpenShore is a coding agent that runs on your own models, your machine, and your keys. Build on Linux, macOS, Windows, iPhone, and iPad, synced over your own private network, private by construction, with cloud one deliberate tap away on your own keys. Free during beta, including the coding agent."
---

<div
  id="oscode-billing"
  data-supabase-url="{{ oscode.checkout.supabaseUrl }}"
  data-anon-key="{{ oscode.checkout.publishableKey }}"
  hidden
></div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "OpenShore",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS, Windows, iOS, iPadOS",
    "url": "{{ site.url }}/",
    "description": "{{ oscode.lede }}",
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.legalName }}",
      "url": "{{ site.parentUrl }}"
    },
    "offers": [
      { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Personal", "price": "20", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Micro", "price": "20", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Small", "price": "100", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Growth", "price": "250", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Scale", "price": "500", "priceCurrency": "USD" }
    ]
  }
</script>

<header class="masthead">
  <div class="masthead-top">
    <div id="oscode-auth" class="oscode-auth"></div>
  </div>
  <h1 class="identity">{{ oscode.headline }}<span class="identity-coda identity-byline">{{ oscode.coda | replace(oscode.codaAccent, '<span class="coda-accent">' + oscode.codaAccent + '</span>') | safe }}</span></h1>
  <div class="horizon" role="presentation"></div>
  <div class="hero-actions">
    <a class="block-cta hero-cta" href="#pricing">See the plans <span aria-hidden="true">&rarr;</span></a>
    <a class="hero-cta-ghost" href="#how-heading">How it works</a>
  </div>
</header>

<section class="block">
  <p class="lede intro-lede">{{ oscode.lede }}</p>
  <p class="prose intro-summary">{{ oscode.summary }}</p>
</section>

