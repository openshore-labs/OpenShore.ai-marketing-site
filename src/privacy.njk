---
layout: base.njk
permalink: /privacy/
pageTitle: "Privacy · OpenShore"
pageDescription: "Your code never leaves home unless you send it. What stays on your own devices, the few things that can leave, and where each one goes."
---
{% import "viz.njk" as viz %}
{% set p = tabpages["privacy"] %}

<header class="subhero">
  <span class="eyebrow">{{ p.hero.eyebrow }}</span>
  <h1>{{ p.hero.headline }}</h1>
  <p class="subhead">{{ p.hero.subhead }}</p>
</header>

<section class="block">{{ viz.staysOnDevice() }}</section>

{% for s in p.sections %}
{{ viz.sec(s) }}
{% endfor %}

<section class="block">
  <a class="block-cta" href="{{ p.cta.href }}">{{ p.cta.label }} <span aria-hidden="true">&rarr;</span></a>
  {% if p.cta.note %}<p class="offer-fine">{{ p.cta.note }}</p>{% endif %}
</section>

